    {
      "name": "List articles",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => {\n    pm.response.to.have.status(200);\n});\n\nconst body = pm.response.json();\n\npm.test(\"data adalah array\", () => \n{\n    pm.expect(body.data).to.be.an(\"array\");\n});\n\npm.test(\"Maksimal 20 artikel (sesuai limit)\", () => {\n    pm.expect(body.data.length).to.be.at.most(20);\n});\n\npm.test(\"tiap artikel punya field wajib\", () => {\n    body.data.forEach((a) => {\n        pm.expect(a).to.include.keys(\"id\", \"organization_id\", \"title\", \"content\", \"source\", \"author\", \"sentiment\", \"published_at\");\n    });\n});\n\npm.test(\"tiap artikel punya url\", () => {\n    body.data.forEach((a) => {\n        pm.expect(a).to.have.property(\"url\")\n    });\n});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{tokenAdmin1}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/articles?page=1&limit=20&sentiment=NEGATIVE&source=kompas.com",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "articles"
          ],
          "query": [
